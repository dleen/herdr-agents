#!/usr/bin/env python3
"""An fzf picker for agent panes and Codex fork branches herdr can reach.

Herdr's own agents panel is a ~30-column sidebar rail, and it only lists panes
whose agent state it managed to detect. This is the wider view: one row per
pane that has an agent session, state resolved even for the panes the sidebar
drops, and a preview reconstructing the session from its transcript — what was
asked, what the agent said back, the shell and edit work folded in between,
then its last message and live screen.

Ships as a herdr plugin: `herdr-plugin.toml` declares it as a popup pane
entrypoint and a key reaches that through the `open` action (see the README).
It is still an ordinary script — runnable from any shell inside a herdr session,
and bindable as a plain `type = "popup"` command.

  herdr-agents            focus an agent, or start one in a listed folder
  herdr-agents --list     print the rows (no fzf, nothing launched or focused)
  herdr-agents --preview <row_key|§folder>  render one entry (used by fzf)
  herdr-agents --lines    print the picker's fzf input (used by its reload)
  herdr-agents --hide <§folder|folder>      drop a folder from the launch list
  herdr-agents --dismiss <§folder|codex-session:UUID>
                           forget a folder or archive a saved Codex branch
  herdr-agents --fork-right
                           fork this pane's Codex session into a right split
  herdr-agents --unhide [folder]            put it back (no argument: all)
  herdr-agents --splash [card] [seconds]    play the launch title cards and exit
"""

from __future__ import annotations

import calendar
import fcntl
import glob
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time

# Panes are matched to a transcript so the picker can show a last message and
# an age. Claude reports a session id and stores <cwd-slug>/<id>.jsonl; pi
# reports the transcript path outright; codex reports an id and files its
# rollout under a date path.
CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")
CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")
CODEX_WRITER_LOCKS = os.path.expanduser("~/.codex/thread-writer-locks")
FORK_LOCK_DIR = os.path.expanduser("~/.local/state/herdr-agents/fork-locks")
FORK_VERIFY_TIMEOUT_S = 15.0
FORK_VERIFY_POLL_S = 0.2
EMPTY_PANE_WAIT_S = 2.0

# Running as a herdr plugin, the binary to call back into is the one herdr
# points at rather than whatever "herdr" resolves to on PATH -- the plugin's
# PATH is the server's, and a managed install need not have herdr on it at all.
HERDR_BIN = os.environ.get("HERDR_BIN_PATH") or "herdr"
CODEX_BIN = os.environ.get("CODEX_BIN_PATH") or "codex"

STATE_ICON = {
    "working": ("*", "\033[33m"),
    "blocked": ("!", "\033[31m"),
    "idle": ("o", "\033[32m"),
    "done": ("o", "\033[32m"),
    "unknown": ("-", "\033[90m"),
    "branch": ("↳", "\033[36m"),
}
STATE_TEXT = {"blocked": "needs input", "done": "done", "idle": "idle",
              "working": "working", "unknown": "?", "branch": "branch"}
RESET = "\033[0m"
DIM = "\033[90m"

# Folder headers are ordinary fzf entries wearing a sentinel key.
HEADER_KEY = "\u00a7"
CODEX_KEY = "codex-session:"
CODEX_ID_PATTERN = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
CODEX_ID_RE = re.compile(
    rf"(?<![0-9a-f])({CODEX_ID_PATTERN})(?![0-9a-f])", re.IGNORECASE
)
JSON_STRING_RE = rb'"(?:[^"\\]|\\.)*"'
CODEX_HEADER_BYTES = 4096


def herdr_run(*args: str, timeout: float = 5):
    """Run a herdr CLI command, returning the CompletedProcess (None if it
    could not be run at all). Callers that need the failure reason want this;
    herdr() is the shorthand for the ones that do not."""
    try:
        return subprocess.run((HERDR_BIN,) + args, capture_output=True, text=True,
                              timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def herdr(*args: str, timeout: float = 5) -> str:
    """Run a herdr CLI command, returning stdout ('' on any failure)."""
    out = herdr_run(*args, timeout=timeout)
    if out is None:
        return ""
    return out.stdout if out.returncode == 0 else ""


def codex_run(*args: str, timeout: float = 5):
    """Run a Codex CLI command, returning None if it could not be started."""
    try:
        return subprocess.run((CODEX_BIN,) + args, capture_output=True, text=True,
                              timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def error_code(stderr: str) -> str:
    """The error code from a failed herdr call. Server errors are JSON on
    stderr; a syntax error (exit 2) is plain text and has none."""
    try:
        return (json.loads(stderr).get("error") or {}).get("code") or ""
    except (ValueError, AttributeError):
        return ""


def herdr_json(*args: str) -> dict:
    try:
        return json.loads(herdr(*args)).get("result", {})
    except (ValueError, AttributeError):
        return {}


def resolve_state(pane: dict) -> str:
    """Herdr's state for a pane, or the one its own rules give the screen.

    A pane herdr never bound to a detected agent process keeps agent_status
    "unknown" forever, even while the agent is plainly sitting on a prompt.
    The content rules still work on it, so ask them directly.
    """
    state = pane.get("agent_status") or "unknown"
    if state != "unknown":
        return state
    agent = (pane.get("agent_session") or {}).get("agent")
    if not agent:
        return state
    screen = herdr("pane", "read", pane["pane_id"], "--source", "detection",
                   "--lines", "80", "--format", "text")
    if not screen.strip():
        return state
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as fh:
        fh.write(screen)
        path = fh.name
    try:
        for line in herdr("agent", "explain", "--file", path,
                          "--agent", agent).splitlines():
            if line.startswith("state:"):
                return line.split(":", 1)[1].strip()
    finally:
        os.unlink(path)
    return state


def transcript_path(pane: dict) -> str | None:
    session = pane.get("agent_session") or {}
    if session.get("kind") == "path":
        return session.get("value")
    if session.get("kind") == "id" and session.get("value"):
        if (session.get("agent") or pane.get("agent") or "").lower() == "codex":
            # ~/.codex/sessions/YYYY/MM/DD/rollout-<stamp>-<id>.jsonl. The date
            # is the session's, not today's, so glob rather than compute it.
            found = glob.glob(os.path.join(CODEX_SESSIONS, "*", "*", "*",
                                           f"rollout-*-{session['value']}.jsonl"))
            return found[0] if found else None
        slug = (pane.get("cwd") or "").replace("/", "-")
        candidate = os.path.join(CLAUDE_PROJECTS, slug, session["value"] + ".jsonl")
        if os.path.exists(candidate):
            return candidate
        # The slug is not a plain "/" → "-" swap for every cwd (spaces and dots
        # are rewritten too), so fall back to finding the id under any project.
        found = glob.glob(os.path.join(CLAUDE_PROJECTS, "*", session["value"] + ".jsonl"))
        return found[0] if found else None
    return None


def header_json_string(header: bytes, field: str) -> str:
    """Read one JSON string field from the small metadata prefix of a rollout.

    A modern Codex session header can be hundreds of kilobytes because its
    first record includes the instructions. The identity fields all precede
    `base_instructions`, so decoding the entire record for every saved session
    would turn opening the picker into a multi-gigabyte scan.
    """
    metadata = header.split(b'"base_instructions"', 1)[0]
    pattern = rb'"' + re.escape(field.encode()) + rb'"\s*:\s*(' + JSON_STRING_RE + rb')'
    match = re.search(pattern, metadata)
    if not match:
        return ""
    try:
        value = json.loads(match.group(1))
    except (UnicodeDecodeError, ValueError):
        return ""
    return value if isinstance(value, str) else ""


def codex_session_meta(path: str) -> dict | None:
    """The identity and user-visible fork edge from a rollout header.

    Codex also uses `forked_from_id` for native subagents. Those have an object
    `source` and no `thread_source: user`; including them would make every
    delegated worker look like a branch the user could resume.
    """
    try:
        with open(path, "rb") as fh:
            header = fh.read(CODEX_HEADER_BYTES)
    except OSError:
        return None
    if not re.search(rb'"type"\s*:\s*"session_meta"', header):
        return None
    session_id = header_json_string(header, "id").lower()
    if not CODEX_ID_RE.fullmatch(session_id):
        return None
    parent = header_json_string(header, "forked_from_id").lower()
    source = header_json_string(header, "source")
    thread_source = header_json_string(header, "thread_source")
    # Only CLI/user forks belong in the picker. Native subagents carry the same
    # fork field but are implementation detail, not resumable peer branches.
    if not (source == "cli" and thread_source == "user"):
        parent = ""
    return {
        "id": session_id,
        "forked_from_id": parent if CODEX_ID_RE.fullmatch(parent) else "",
        "cwd": header_json_string(header, "cwd"),
        "path": path,
    }


def codex_session_index() -> dict[str, dict]:
    """Index Codex rollout headers without reading their transcript bodies."""
    sessions = {}
    pattern = os.path.join(CODEX_SESSIONS, "*", "*", "*", "rollout-*.jsonl")
    for path in glob.iglob(pattern):
        meta = codex_session_meta(path)
        if meta:
            sessions[meta["id"]] = meta
    return sessions


def codex_session_by_id(session_id: str) -> dict | None:
    """Return one unambiguous active rollout header for ``session_id``."""
    if not CODEX_ID_RE.fullmatch(session_id or ""):
        return None
    pattern = os.path.join(
        CODEX_SESSIONS, "*", "*", "*", f"rollout-*-{session_id}.jsonl"
    )
    matches = []
    for path in glob.iglob(pattern):
        meta = codex_session_meta(path)
        if meta and meta["id"] == session_id:
            matches.append(meta)
    return matches[0] if len(matches) == 1 else None


def codex_fork_graph(sessions: dict[str, dict]) -> dict[str, set[str]]:
    graph: dict[str, set[str]] = {}
    for session_id, meta in sessions.items():
        parent = meta.get("forked_from_id") or ""
        if not parent:
            continue
        graph.setdefault(session_id, set()).add(parent)
        graph.setdefault(parent, set()).add(session_id)
    return graph


def codex_component(session_id: str, graph: dict[str, set[str]]) -> set[str]:
    if not session_id:
        return set()
    found, pending = set(), [session_id]
    while pending:
        current = pending.pop()
        if current in found:
            continue
        found.add(current)
        pending.extend(graph.get(current, ()))
    return found


def codex_title_session_id(pane: dict, reported: str,
                           sessions: dict[str, dict],
                           graph: dict[str, set[str]]) -> str:
    """Prefer the Codex terminal title during the reporter's post-switch lag."""
    candidates = [value.lower() for value in
                  CODEX_ID_RE.findall(pane.get("terminal_title_stripped") or "")]
    if reported in candidates:
        return reported
    related = codex_component(reported, graph)
    cwd = pane.get("cwd") or ""
    for candidate in candidates:
        meta = sessions.get(candidate)
        if (meta and candidate in related
                and (not cwd or not meta.get("cwd") or meta["cwd"] == cwd)):
            return candidate
    return reported


def codex_writer_active(session_id: str) -> bool:
    """Whether Codex's POSIX writer lock is currently held for this thread."""
    path = os.path.join(CODEX_WRITER_LOCKS, f"{session_id}.lock")
    try:
        with open(path, "r+") as fh:
            try:
                fcntl.lockf(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            except OSError:
                # A lock we cannot inspect is unsafe to treat as dormant: a
                # second writer would fail after the picker has made a new pane.
                return True
            fcntl.lockf(fh.fileno(), fcntl.LOCK_UN)
            return False
    except FileNotFoundError:
        return False
    except OSError:
        return True


def codex_lock_pids(session_id: str) -> set[int] | None:
    """Writer process IDs when lsof is available; None means not observable."""
    if not shutil.which("lsof"):
        return None
    path = os.path.join(CODEX_WRITER_LOCKS, f"{session_id}.lock")
    try:
        done = subprocess.run(["lsof", "-t", "--", path], capture_output=True,
                              text=True, timeout=3, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    pids = set()
    for line in done.stdout.splitlines():
        try:
            pids.add(int(line))
        except ValueError:
            pass
    return pids


def codex_pane_pids(pane_id: str) -> set[int]:
    info = herdr_json("pane", "process-info", "--pane", pane_id).get("process_info") or {}
    return {process["pid"] for process in info.get("foreground_processes") or []
            if isinstance(process.get("pid"), int)}


def normalized_path(path: str) -> str:
    return os.path.realpath(os.path.abspath(os.path.expanduser(path))) if path else ""


def codex_foreground_process(pane_id: str) -> tuple[dict | None, str]:
    """Return the one local foreground Codex process in ``pane_id``."""
    info = (herdr_json("pane", "process-info", "--pane", pane_id)
            .get("process_info") or {})
    if info.get("pane_id") != pane_id:
        return None, "could not inspect the invoking pane's foreground process"
    processes = info.get("foreground_processes") or []
    if len(processes) != 1:
        return None, "the invoking pane does not have exactly one foreground process"
    process = processes[0]
    names = [process.get("argv0"), process.get("name")]
    argv = process.get("argv") or []
    if argv:
        names.append(argv[0])
    basenames = {os.path.basename(str(name)).lower() for name in names if name}
    if not any(name == "codex" or name.startswith("codex-") for name in basenames):
        return None, "the invoking pane's foreground process is not local Codex"
    if not isinstance(process.get("pid"), int) or process["pid"] <= 0:
        return None, "the invoking pane's Codex process has no usable pid"
    if not process.get("cwd"):
        return None, "the invoking pane's Codex process has no working directory"
    return process, ""


def local_codex_pane(pane_id: str) -> tuple[dict | None, str]:
    """Resolve a pane only when every local Codex identity source agrees."""
    pane = herdr_json("pane", "get", pane_id).get("pane") or {}
    if pane.get("pane_id") != pane_id:
        return None, "the invoking Herdr pane no longer exists"
    session = pane.get("agent_session") or {}
    if ((session.get("agent") or pane.get("agent") or "").lower() != "codex"
            or session.get("kind") != "id"):
        return None, "the invoking pane is not reporting a local Codex session"
    session_id = str(session.get("value") or "").lower()
    if not CODEX_ID_RE.fullmatch(session_id):
        return None, "the invoking pane has no valid Codex session id"

    title_ids = {value.lower() for value in
                 CODEX_ID_RE.findall(pane.get("terminal_title_stripped") or "")}
    if title_ids != {session_id}:
        return None, "Codex's terminal title and Herdr session reporter disagree"
    meta = codex_session_by_id(session_id)
    if not meta:
        return None, f"could not resolve one active rollout for {session_id}"

    process, why = codex_foreground_process(pane_id)
    if not process:
        return None, why
    cwd_sources = {
        normalized_path(str(pane.get("cwd") or "")),
        normalized_path(str(pane.get("foreground_cwd") or "")),
        normalized_path(str(process.get("cwd") or "")),
        normalized_path(str(meta.get("cwd") or "")),
    }
    if "" in cwd_sources or len(cwd_sources) != 1:
        return None, "the pane, Codex process, and rollout working directories disagree"

    if not codex_writer_active(session_id):
        return None, f"{session_id} does not have an active Codex writer lock"
    lock_pids = codex_lock_pids(session_id)
    if lock_pids is None:
        return None, "lsof is required to prove Codex writer-lock ownership"
    if lock_pids != {process["pid"]}:
        return None, "the foreground Codex process does not uniquely own its writer lock"
    return {
        "pane_id": pane_id,
        "session_id": session_id,
        "pid": process["pid"],
        # Preserve the user's path spelling for the child; cwd_real is the
        # identity comparison that tolerates a symlinked checkout.
        "cwd": str(pane["cwd"]),
        "cwd_real": cwd_sources.pop(),
        "meta": meta,
    }, ""


def verify_fork_child(parent: dict, child_pane_id: str) -> tuple[str, str]:
    """Prove parent and child are distinct, correctly related Codex writers."""
    current_parent, why = local_codex_pane(parent["pane_id"])
    if not current_parent:
        return "", f"parent verification failed: {why}"
    stable_fields = ("session_id", "pid", "cwd", "cwd_real")
    if any(current_parent[field] != parent[field] for field in stable_fields):
        return "", "the parent Codex session or process changed during the fork"

    child, why = local_codex_pane(child_pane_id)
    if not child:
        return "", f"child verification pending: {why}"
    if child["session_id"] == parent["session_id"]:
        return "", "the new pane reported the parent session instead of a fork"
    if child["meta"].get("forked_from_id") != parent["session_id"]:
        return "", "the new Codex rollout does not identify the requested parent"
    if child["cwd_real"] != parent["cwd_real"]:
        return "", "the fork opened in a different working directory"
    if child["pid"] == parent["pid"]:
        return "", "parent and child writer locks belong to the same process"
    return child["session_id"], ""


def wait_for_fork_child(parent: dict, child_pane_id: str,
                        timeout: float = FORK_VERIFY_TIMEOUT_S) -> tuple[str, str]:
    deadline = time.monotonic() + timeout
    why = "the child Codex session did not become observable"
    while True:
        child_id, observed = verify_fork_child(parent, child_pane_id)
        if child_id:
            return child_id, ""
        why = observed or why
        if time.monotonic() >= deadline:
            return "", why
        time.sleep(FORK_VERIFY_POLL_S)


def pane_provably_empty(pane_id: str) -> bool:
    """True only for a created pane whose shell is idle and has no agent."""
    pane = herdr_json("pane", "get", pane_id).get("pane") or {}
    if pane.get("pane_id") != pane_id:
        return False
    if pane.get("agent") or (pane.get("agent_session") or {}).get("agent"):
        return False
    info = (herdr_json("pane", "process-info", "--pane", pane_id)
            .get("process_info") or {})
    return (info.get("pane_id") == pane_id
            and isinstance(info.get("shell_pid"), int)
            and not (info.get("foreground_processes") or []))


def close_created_empty_pane(pane_id: str,
                             timeout: float = EMPTY_PANE_WAIT_S) -> bool:
    """Close only a pane we created and can still prove is an idle shell."""
    deadline = time.monotonic() + timeout
    while not pane_provably_empty(pane_id):
        if time.monotonic() >= deadline:
            return False
        time.sleep(FORK_VERIFY_POLL_S)
    done = herdr_run("pane", "close", pane_id, timeout=10)
    return done is not None and done.returncode == 0


def flat(text: str, limit: int = 400) -> str:
    return " ".join(str(text).split())[:limit]


def tool_label(name: str, args: dict) -> str:
    """One line describing a tool call, in the terms the user thinks in."""
    args = args if isinstance(args, dict) else {}
    low = (name or "").lower()
    if low.startswith("mcp__"):
        parts = name.split("__")
        return f"{parts[1]}: {parts[-1]}" if len(parts) > 2 else name
    if low == "bash":
        return flat(args.get("description") or args.get("command") or "bash")
    if low in ("read", "edit", "write", "notebookedit", "multiedit"):
        target = args.get("file_path") or args.get("path") or args.get("notebook_path") or ""
        return f"{low} {os.path.basename(target) or target}"
    if low in ("grep", "glob"):
        return f"{low} {flat(args.get('pattern') or args.get('query') or '')}"
    if low in ("task", "agent"):
        kind = args.get("subagent_type") or args.get("model") or "agent"
        return f"agent[{kind}] {flat(args.get('description') or '')}"
    if low == "todowrite":
        for todo in args.get("todos") or []:
            if isinstance(todo, dict) and todo.get("status") == "in_progress":
                return "todo " + flat(todo.get("activeForm") or todo.get("content") or "")
        return "todo list updated"
    if low == "skill":
        return f"skill {args.get('skill') or ''}".strip()
    if low == "webfetch":
        return f"fetch {flat(args.get('url') or '')}"
    if low == "websearch":
        return f"search {flat(args.get('query') or '')}"
    if low == "workflow":
        return f"workflow {flat(args.get('name') or 'inline script')}"
    first = next((str(v) for v in args.values() if isinstance(v, (str, int))), "")
    return f"{name} {flat(first, 80)}".strip()


def stamp(value) -> float:
    """Transcript timestamps are UTC ISO; return epoch seconds (0 if absent).

    timegm, not mktime minus time.timezone: that offset is the zone's standard
    one and ignores DST, so every parsed time was an hour early for half the
    year. Harmless while these only fed a duration, wrong the moment a clock
    time is printed.
    """
    if not value:
        return 0.0
    try:
        return float(calendar.timegm(time.strptime(str(value)[:19], "%Y-%m-%dT%H:%M:%S")))
    except ValueError:
        return 0.0


def read_session(path: str | None, tail_bytes: int = 12_000_000) -> dict:
    """Parse a Claude or pi transcript into a common activity summary.

    Returns events (chronological), counters, and the last assistant message.
    Only the tail is read, so a very long session reports partial counts —
    flagged with `truncated` rather than quietly under-reported.
    """
    out = {"events": [], "prompts": 0, "tools": 0, "tokens": 0, "commits": 0,
           "files": [], "errors": 0, "last": "", "model": "", "title": "",
           "started": 0.0, "truncated": False}
    if not path or not os.path.exists(path):
        return out
    try:
        with open(path, "rb") as fh:
            size = os.fstat(fh.fileno()).st_size
            if size > tail_bytes:
                fh.seek(size - tail_bytes)
                fh.readline()  # drop the partial line the seek landed inside
                out["truncated"] = True
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return out

    seen_usage, files = set(), []
    for line in lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("isSidechain") or rec.get("isMeta"):
            continue
        when = stamp(rec.get("timestamp"))
        if when and not out["started"]:
            out["started"] = when
        kind = rec.get("type")
        if kind == "ai-title" and rec.get("aiTitle"):
            out["title"] = flat(rec["aiTitle"], 120)
            continue
        # pi wraps everything in {"type": "message", "message": {...}}; Claude
        # puts the role in the record type. Normalise to (role, content).
        message = rec.get("message")
        if kind == "message" and isinstance(message, dict):
            role = message.get("role")
        elif kind in ("user", "assistant") and isinstance(message, dict):
            role = kind
        else:
            continue
        content = message.get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        if not isinstance(content, list):
            continue

        if role == "assistant":
            usage = message.get("usage") or {}
            key = (message.get("id"), rec.get("requestId"))
            billed = (usage.get("cache_read_input_tokens", 0)
                      or usage.get("cache_creation_input_tokens", 0))
            if billed and key not in seen_usage:  # an API error carries zeros
                seen_usage.add(key)
                out["tokens"] += (usage.get("input_tokens", 0) + billed
                                  + usage.get("output_tokens", 0))
            if message.get("model"):
                out["model"] = message["model"]

        for block in content:
            if not isinstance(block, dict):
                continue
            btype = block.get("type")
            if btype == "text" and block.get("text", "").strip():
                text = flat(block["text"], 2000)
                if role == "assistant":
                    out["events"].append((when, "say", text, ""))
                    out["last"] = text
                elif role == "user":
                    out["prompts"] += 1
                    out["events"].append((when, "prompt", text, ""))
            elif btype in ("tool_use", "toolCall"):
                name = block.get("name", "")
                args = block.get("input") or block.get("arguments") or {}
                out["tools"] += 1
                out["events"].append((when, "tool", tool_label(name, args), name.lower()))
                if name.lower() in ("edit", "write", "multiedit", "notebookedit"):
                    target = args.get("file_path") or args.get("path") or ""
                    if target and target not in files:
                        files.append(target)
                if name.lower() == "bash" and "git commit" in str(args.get("command", "")):
                    out["commits"] += 1
            elif btype == "tool_result" and block.get("is_error"):
                out["errors"] += 1
    out["files"] = files
    return out


def session_times(path: str | None) -> tuple[float, float]:
    """(created, last activity) for a transcript, as epoch seconds; 0.0 if unknown.

    Both come from the file, because herdr's API carries no time at all: pane,
    agent and snapshot responses expose `revision` and `state_change_seq`
    (monotonic counters) and a `focused` flag, but no created-at, no
    last-state-change and no last-focused stamp. So "when did I last look at
    this pane" is not recoverable — "when did this session last do something"
    is, and it is the better question anyway.

    Creation is the file's birth time, which is the first write rather than the
    process start: measured a few seconds to two minutes late, since an agent
    opens its transcript when it has something to put in it. Fine for ranking
    and for "how long has this been going". st_birthtime is missing on Linux,
    where ctime is the closest thing available.
    """
    if not path:
        return (0.0, 0.0)
    try:
        info = os.stat(path)
    except OSError:
        return (0.0, 0.0)
    return (getattr(info, "st_birthtime", None) or info.st_ctime, info.st_mtime)


def ago(when: float) -> str:
    """An age in at most four cells: 45s, 12m, 3h, 5d ('' if unknown)."""
    if not when:
        return ""
    delta = max(0.0, time.time() - when)
    if delta < 90:
        return f"{int(delta)}s"
    if delta < 5400:
        return f"{int(delta / 60)}m"
    if delta < 172_800:
        return f"{int(delta / 3600)}h"
    return f"{int(delta / 86400)}d"


def clock(when: float) -> str:
    """Absolute local time, gaining a weekday once it is not today."""
    if not when:
        return ""
    local = time.localtime(when)
    same_day = time.strftime("%Y-%m-%d", local) == time.strftime("%Y-%m-%d")
    return time.strftime("%H:%M" if same_day else "%a %H:%M", local)


def codex_branch_rows(rows: list[dict], sessions: dict[str, dict],
                      graph: dict[str, set[str]]) -> list[dict]:
    """Saved peers of live Codex sessions, with their safe activation route."""
    live = [row for row in rows
            if row["agent"].lower() == "codex" and row.get("session_id")]
    live_ids = {row["session_id"] for row in live}
    added, branches = set(), []
    pane_pid_cache: dict[str, set[int]] = {}
    lock_pid_cache: dict[str, set[int] | None] = {}
    seen_components: set[frozenset[str]] = set()

    for anchor in live:
        component = codex_component(anchor["session_id"], graph)
        frozen = frozenset(component)
        if len(component) < 2 or frozen in seen_components:
            continue
        seen_components.add(frozen)
        candidates = [row for row in live
                      if row["session_id"] in component
                      or row.get("reported_session_id") in component]

        for session_id in component:
            if session_id in live_ids or session_id in added:
                continue
            meta = sessions.get(session_id)
            if not meta:
                continue
            added.add(session_id)
            active = codex_writer_active(session_id)
            owner = None
            if active:
                lock_pids = lock_pid_cache.setdefault(
                    session_id, codex_lock_pids(session_id))
                if lock_pids is not None:
                    matches = []
                    for candidate in candidates:
                        pane_id = candidate["pane_id"]
                        pids = pane_pid_cache.setdefault(pane_id,
                                                         codex_pane_pids(pane_id))
                        if pids & lock_pids:
                            matches.append(candidate)
                    if len(matches) == 1:
                        owner = matches[0]
                else:
                    # Without lsof, only the stale reporter value is direct
                    # ownership evidence. A lone related pane is not enough:
                    # the branch may be open in an external Codex process.
                    reported = [row for row in candidates
                                if row.get("reported_session_id") == session_id]
                    if len(reported) == 1:
                        owner = reported[0]

            host = owner or (min(candidates, key=lambda row: row["number"])
                             if candidates else {})
            cwd = meta.get("cwd") or host.get("cwd") or ""
            born, changed = session_times(meta.get("path"))
            relation = "fork" if meta.get("forked_from_id") else "fork parent"
            if owner:
                mode = f"switch in {owner['number']}"
            elif active:
                mode = "open outside herdr"
            else:
                mode = "resume new"
            branches.append({
                "key": CODEX_KEY + session_id,
                "row_kind": "codex_branch",
                "session_id": session_id,
                "reported_session_id": "",
                "forked_from_id": meta.get("forked_from_id") or "",
                "active_writer": active,
                "owner_pane_id": owner.get("pane_id", "") if owner else "",
                "pane_id": owner.get("pane_id", "") if owner else "",
                "workspace_id": owner.get("workspace_id", "") if owner else "",
                "tab_id": owner.get("tab_id", "") if owner else "",
                "agent": "codex",
                "state": "branch",
                "number": host.get("number", 0),
                "label": host.get("label") or os.path.basename(cwd) or "codex",
                "focused": False,
                "title": f"{relation} · {mode} · {session_id}",
                "cwd": cwd,
                "transcript": meta.get("path"),
                "born_at": born,
                "active_at": changed,
                "age": ago(changed),
                "born": ago(born),
            })
    return branches


def collect() -> list[dict]:
    panes = herdr_json("pane", "list").get("panes") or []
    spaces = {w["workspace_id"]: w
              for w in herdr_json("workspace", "list").get("workspaces") or []}
    has_codex = any(((pane.get("agent_session") or {}).get("agent")
                     or pane.get("agent") or "").lower() == "codex"
                    for pane in panes)
    codex_sessions = codex_session_index() if has_codex else {}
    codex_graph = codex_fork_graph(codex_sessions)
    rows = []
    for pane in panes:
        agent = (pane.get("agent_session") or {}).get("agent") or pane.get("agent")
        if not agent:
            continue
        space = spaces.get(pane.get("workspace_id"), {})
        session = pane.get("agent_session") or {}
        reported = (session.get("value") or "").lower() if (
            agent.lower() == "codex" and session.get("kind") == "id") else ""
        session_id = (codex_title_session_id(pane, reported, codex_sessions, codex_graph)
                      if reported else "")
        path = ((codex_sessions.get(session_id) or {}).get("path")
                if session_id else None) or transcript_path(pane)
        born, active = session_times(path)
        rows.append({
            "key": pane["pane_id"],
            "row_kind": "live",
            "session_id": session_id or reported,
            "reported_session_id": reported,
            "pane_id": pane["pane_id"],
            "workspace_id": pane.get("workspace_id", ""),
            "tab_id": pane.get("tab_id", ""),
            "agent": agent,
            "state": resolve_state(pane),
            "number": space.get("number", 0),
            "label": space.get("label", pane.get("workspace_id", "")),
            "focused": pane.get("focused") or space.get("focused") or False,
            "title": pane.get("terminal_title_stripped") or "",
            "cwd": pane.get("cwd") or "",
            "transcript": path,
            "born_at": born,
            "active_at": active,
            "age": ago(active),
            "born": ago(born),
        })
    if codex_graph:
        rows.extend(codex_branch_rows(rows, codex_sessions, codex_graph))
    rows.sort(key=order)
    return rows


def order(row: dict) -> tuple:
    """Anything wanting a human first, then the busy ones, then the rest — and
    inside a tier, whatever moved most recently.

    State alone stops sorting the moment a screenful of agents is all idle,
    which is the normal state of a long session: a dozen rows in one bucket,
    ordered by workspace number, so the one you were in five minutes ago sits
    wherever it was created. Recency breaks that tie the way you would by hand.
    A row with no transcript has no time to rank by and sinks to the bottom of
    its tier, where workspace number still orders it.
    """
    return (URGENCY.get(row["state"], 4), -row["active_at"], row["number"])


# Groups are keyed on the full cwd, not the workspace label: two worktrees of
# the same repo both show up as "settings" but are different work.
URGENCY = {"blocked": 0, "working": 1, "idle": 2, "done": 2,
           "unknown": 3, "branch": 3}


def group_by_folder(rows: list[dict], extra: int = 12) -> list[tuple[str, object]]:
    """Rows bucketed by cwd, each bucket led by a folder entry.

    Buckets are ordered by their most urgent agent so a folder with something
    waiting on a human still floats to the top, then by their most recently
    active one so a quiet checkout does not outrank the one you are working in.
    Folders with nothing running follow, so the same list answers both "go to
    an agent" and "start one somewhere else".
    """
    folders: dict[str, list[dict]] = {}
    for row in rows:
        folders.setdefault(row["cwd"] or "?", []).append(row)
    ordered = sorted(folders.items(),
                     key=lambda kv: (min(URGENCY.get(r["state"], 4) for r in kv[1]),
                                     -max(r["active_at"] for r in kv[1]),
                                     kv[0]))
    out: list[tuple[str, object]] = []
    for folder, members in ordered:
        out.append(("header", folder))
        out.extend(("row", r) for r in sorted(members, key=order))
    for folder in recent_folders(limit=len(folders) + extra):
        if folder not in folders:
            out.append(("header", folder))
    return out


def short_path(folder: str) -> str:
    return (folder or "").replace(os.path.expanduser("~"), "~")


def render_header(folder: str, count: int, color: bool = True) -> str:
    path = short_path(folder)
    head, _, base = path.rpartition("/")
    # A folder with agents is labelled by how many; one without is labelled by
    # what enter would start there, since starting is the only thing it offers.
    tally = f"({count})" if count else f"+ {default_kind(folder)}"
    if not color:
        return f"{path}  {tally}"
    return f"{DIM}{head}/{RESET}\033[1m{base}{RESET}{DIM}  {tally}{RESET}"


def render(row: dict, color: bool = True, folder: bool = False) -> str:
    """One agent row, optionally ending in its folder.

    The folder is redundant under its own header and is only for fzf: with
    --with-nth, fzf matches a line against what it *displays*, so a hidden
    search field is not available and a query naming a folder would filter out
    the very agents running in it. Carrying the same path string the header
    shows keeps a group whole under any query that matches either half. Last on
    the line is where it costs least — in a narrow list it is clipped, and fzf
    scrolls the row along only when the match is out there.
    """
    icon, hue = STATE_ICON.get(row["state"], STATE_ICON["unknown"])
    on, off, dim = (hue, RESET, DIM) if color else ("", "", "")
    state = STATE_TEXT.get(row["state"], row["state"])
    # Two ages, closest thing first: how long since it did anything, then how
    # long it has existed. The second is dimmed because it never changes what
    # you do next -- it is there to tell a session opened after lunch from one
    # that has been grinding since Tuesday.
    head = (f"  {on}{icon}{off} {row['number']:>2}  {state:<11} "
            f"{row['age']:>4} {dim}{row['born']:>4}{off}")
    tail = f"  {short_path(row['cwd'])}" if folder and row.get("cwd") else ""
    return f"{head} {dim}{row['agent']:<6} {row['title'][:70]}{tail}{off}"


CYAN = "\033[36m"

# Tool calls are grouped into the run between two things a human said, because
# a bare list of 114 bash lines is not "what happened" — it is noise with
# timestamps. Each verb collapses differently: shell work and edits are named,
# lookups are only counted.
TOOL_GROUP = {
    "bash": "run", "edit": "edit", "write": "edit", "multiedit": "edit",
    "notebookedit": "edit", "read": "look", "grep": "look", "glob": "look",
}


def collapse(events: list, width: int) -> list:
    """Turn a flat event list into conversation lines with tool runs folded in."""
    lines, run = [], []

    def flush():
        if not run:
            return
        named, edits, looks, notable = [], [], 0, []
        for name, label in run:
            group = TOOL_GROUP.get(name)
            if group == "edit":
                target = label.split(" ", 1)[-1]
                if target not in edits:
                    edits.append(target)
            elif group == "look":
                looks += 1
            elif group == "run":
                named.append(label)  # a bash call is its description
            else:
                notable.append(label)  # agent, skill, an MCP tool: name it
        if named:
            extra = f" (+{len(named) - 3})" if len(named) > 3 else ""
            lines.append(("", "$", DIM, " · ".join(named[:3]) + extra))
        if edits:
            lines.append(("", "✎", DIM, ", ".join(edits[:5])))
        if looks:
            lines.append(("", "⋯", DIM, f"{looks} lookup{'s' if looks > 1 else ''}"))
        for label in notable[:3]:
            lines.append(("", "⚙", DIM, label))
        run.clear()

    for when, kind, text, name in events:
        at = time.strftime("%H:%M", time.localtime(when)) if when else ""
        if kind == "tool":
            run.append((name, text))
            continue
        flush()
        mark, hue = ("▸", CYAN) if kind == "prompt" else ("⤷", "")
        lines.append((at, mark, hue, text))
    flush()
    cap = max(20, width - 9)
    return [(a, m, h, t if len(t) <= cap else t[: cap - 1] + "…")
            for a, m, h, t in lines]


def tokens_short(count: int) -> str:
    if count >= 1_000_000:
        return f"{count / 1_000_000:.1f}M tok"
    if count >= 1000:
        return f"{count // 1000}k tok"
    return f"{count} tok" if count else ""


def preview_folder(folder: str) -> int:
    """A folder entry: what runs here now, and what enter would start."""
    members = [r for r in collect() if r["cwd"] == folder]
    print(render_header(folder, len(members)))
    try:
        git = subprocess.run(["git", "-C", folder, "status", "--porcelain", "-b"],
                             capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        git = None
    if git is not None and git.returncode == 0:
        lines = git.stdout.splitlines()
        dirty = len(lines) - 1
        print(f"{DIM}{lines[0][3:] if lines else ''}  ·  "
              f"{dirty} change{'s' if dirty != 1 else ''}{RESET}")

    info = load_state().get("folders", {}).get(folder) or {}
    started = (f"{info['count']}× from here, last {info['kind']} "
               f"{ago(info['last'])} ago" if info.get("last") else
               "never started from here")
    print(f"\n{DIM}enter{RESET} start {default_kind(folder)}   "
          f"{DIM}ctrl-a{RESET} choose agent   "
          f"{DIM}ctrl-x{RESET} forget this folder\n{DIM}{started}{RESET}")

    if members:
        print(f"\n{DIM}running here{RESET}")
        for row in members:
            print(render(row))
    return 0


def preview_window() -> str:
    """Where to put the preview, in absolute cells.

    fzf's own conditional form (`right,55%,<160(down,60%)`) picks the
    alternative at any width in 0.74 — measured — so the split is decided here
    instead. Narrow popups get a full-width preview underneath, because the
    activity timeline and last message are prose and 40 columns shreds them.
    """
    cols, lines = shutil.get_terminal_size((120, 40))
    if cols >= 170:
        return f"right,{cols // 2},wrap"
    return f"down,{max(14, lines * 3 // 5)},wrap,border-top"


def preview(row_key: str, events_shown: int = 16) -> int:
    if row_key.startswith(HEADER_KEY):
        return preview_folder(row_key[len(HEADER_KEY):])
    row = next((r for r in collect() if r["key"] == row_key), None)
    if row is None:
        print("pane or saved branch is gone")
        return 0
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS") or 78)
    # Codex files a rollout in its own schema (response_item / event_msg), which
    # this parser does not read: its transcript is used for times only, and
    # parsing it would buy an empty summary for a multi-megabyte read.
    session = read_session(row["transcript"] if row["agent"] != "codex" else None)

    print(f"\033[1m{row['label']}\033[0m  {row['agent']}  "
          f"{STATE_TEXT.get(row['state'], row['state'])}"
          f"{'  ' + row['age'] + ' ago' if row['age'] else ''}")
    model = (session["model"] or "").replace("claude-", "")
    identity = (row.get("session_id") if row.get("row_kind") == "codex_branch"
                else row["pane_id"])
    meta = [row["cwd"].replace(os.path.expanduser("~"), "~"), identity, model]
    print(f"{DIM}{'  ·  '.join(m for m in meta if m)}{RESET}")

    # Wall clock, not just ages: "started 09:11" is what you match against your
    # own memory of the morning. The transcript's first record beats the file's
    # birth time when it is there, being the session's own idea of when it began.
    when = []
    began = session["started"] or row["born_at"]
    if began:
        when.append(f"started {clock(began)} ({ago(began)} ago)")
    if row["active_at"]:
        when.append(f"last active {clock(row['active_at'])} ({row['age']} ago)")
    if when:
        print(f"{DIM}{'  ·  '.join(when)}{RESET}")

    title = session["title"] or row["title"]
    if title:
        print(f"\n{title}")

    if row.get("row_kind") == "codex_branch":
        if row.get("owner_pane_id"):
            action = (f"switch the existing Codex pane {row['owner_pane_id']} "
                      f"with /resume {row['session_id']}")
        elif row.get("active_writer"):
            action = "refuse a second writer; this branch is open outside herdr"
        else:
            action = "open codex resume in a new herdr workspace"
        print(f"\n{DIM}enter{RESET} {action}")
        if row.get("active_writer"):
            archive = (f"active branch: open it and use /archive; transcript is "
                       f"preserved and restorable with codex unarchive "
                       f"{row['session_id']}")
        else:
            archive = (f"archive with ctrl-x; transcript is preserved and "
                       f"restorable with codex unarchive {row['session_id']}")
        print(f"{DIM}ctrl-x{RESET} {archive}")
        if row.get("forked_from_id"):
            print(f"{DIM}forked from {row['forked_from_id']}{RESET}")

    # What the session has cost in effort, not dollars: pricing a transcript by
    # hand is its own trap -- rates move, cache reads are not cache writes --
    # and turn and tool counts answer "what happened here" better anyway.
    stats = [f"{session['prompts']} prompts", f"{session['tools']} tools"]
    if session["commits"]:
        stats.append(f"{session['commits']} commits")
    if session["errors"]:
        stats.append(f"{session['errors']} tool errors")
    if session["tokens"]:
        stats.append(tokens_short(session["tokens"]))
    if session["prompts"] or session["tools"]:
        lead = "…" if session["truncated"] else ""
        print(f"\n{DIM}{lead}{'  ·  '.join(stats)}{RESET}")

    lines = collapse(session["events"], width)
    if lines:
        shown = lines[-events_shown:]
        # A window of pure agent output loses the thread. If the last thing the
        # user asked scrolled off, put it back at the top of the window.
        if not any(mark == "▸" for _, mark, _, _ in shown):
            last_ask = next((ln for ln in reversed(lines) if ln[1] == "▸"), None)
            if last_ask:
                shown = [last_ask] + shown[1:]
        print(f"\n{DIM}activity{RESET}")
        for at, mark, hue, text in shown:
            stamped = f"{DIM}{at:<5}{RESET}"
            print(f"{stamped} {hue}{mark} {text}{RESET if hue else ''}")

    if session["files"]:
        shown = [os.path.basename(f) for f in session["files"][-8:]]
        print(f"\n{DIM}files touched{RESET}\n{', '.join(shown)}")

    if session["last"]:
        print(f"\n{DIM}last message{RESET}\n{session['last'][:600]}")

    screen = (herdr("pane", "read", row["pane_id"], "--source", "recent",
                    "--lines", "30", "--format", "text")
              if row.get("row_kind") == "live" else "")
    if screen.strip():
        print(f"\n{DIM}screen{RESET}")
        print(screen.rstrip())
    return 0


def focus(row: dict) -> int:
    """Focus a pane. agent focus only accepts panes herdr detected as agents,
    so fall back to walking workspace then tab."""
    if herdr("agent", "focus", row["pane_id"]).strip():
        return 0
    herdr("workspace", "focus", row["workspace_id"])
    if row["tab_id"]:
        herdr("tab", "focus", row["tab_id"])
    return 0


def activate_codex_branch(row: dict) -> int:
    """Switch through the writer that owns a branch, or start a dormant one."""
    session_id = row["session_id"]
    # fzf may stay open while another client switches or closes the target.
    # Refresh ownership at the moment enter is pressed rather than acting on a
    # stale lock snapshot from when the list was drawn.
    current = collect()
    live = next((candidate for candidate in current
                 if candidate.get("row_kind") == "live"
                 and candidate.get("session_id") == session_id), None)
    if live:
        return focus(live)
    row = next((candidate for candidate in current
                if candidate.get("key") == CODEX_KEY + session_id), row)

    if codex_writer_active(session_id):
        owner = row.get("owner_pane_id") or ""
        if not owner:
            herdr("notification", "show", "Codex branch is already open",
                  "--body", f"{session_id} has an active writer outside a "
                            "uniquely identifiable herdr pane")
            return 1
        command = f"/resume {session_id}"
        done = herdr_run("agent", "prompt", owner, command, timeout=10)
        # Put the user where the switch (or its visible Codex error) happened.
        focus(row)
        if done is not None and done.returncode == 0:
            return 0
        why = (error_code(done.stderr) if done else "") or "could not send /resume"
        herdr("notification", "show", "Could not switch Codex branch",
              "--body", f"{owner}: {why}")
        return 1

    folder = row.get("cwd") or ""
    if not folder:
        herdr("notification", "show", "Could not resume Codex branch",
              "--body", f"no working directory was recorded for {session_id}")
        return 1
    return launch(folder, "codex", agent_args=("resume", session_id))


def activate(row: dict) -> int:
    if row.get("row_kind") == "codex_branch":
        return activate_codex_branch(row)
    return focus(row)


# ---------------------------------------------------------------- launching

STATE_FILE = os.path.expanduser("~/.local/state/herdr-agents/launches.json")
AGENT_KINDS = ("claude", "codex", "pi")


def load_state() -> dict:
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as fh:
            json.dump(state, fh, indent=1)
    except OSError:
        pass  # a lost preference is not worth failing a launch over


def hidden_folders(state: dict | None = None) -> set[str]:
    state = load_state() if state is None else state
    return {str(f).rstrip("/") for f in state.get("hidden") or []}


#: Enough dismissals to cover a machine's worth of junk paths without letting a
#: held-down key grow the state file unboundedly.
HIDDEN_CAP = 200


def hide_folder(folder: str) -> int:
    """Drop a folder from the suggestion list for good.

    Two of the three sources are not ours to prune — zoxide ranks /tmp because
    something cd'd there, and herdr lists a pane because it exists — so the
    dismissal is recorded here and applied as a filter. The folder's own launch
    history goes with it: this is "remove this entry", not "rank it lower".

    A folder with an agent running in it is refused. Its header is built from
    that agent's row rather than from the suggestion list, so it would stay on
    screen and the keypress would look broken.
    """
    folder = (folder or "").rstrip("/")
    if not folder:
        return 0
    live = {(p.get("cwd") or "").rstrip("/")
            for p in herdr_json("pane", "list").get("panes") or []
            if (p.get("agent_session") or {}).get("agent") or p.get("agent")}
    if folder in live:
        herdr("notification", "show", "herdr-agents",
              "--body", f"{os.path.basename(folder) or folder} still has an agent "
                        "running — close it first")
        return 1
    state = load_state()
    hidden = [f for f in state.get("hidden") or [] if str(f).rstrip("/") != folder]
    hidden.append(folder)
    state["hidden"] = hidden[-HIDDEN_CAP:]
    state.get("folders", {}).pop(folder, None)
    save_state(state)
    return 0


def archive_codex_branch(session_id: str) -> int:
    """Archive one dormant saved Codex branch without touching its transcript."""
    if not CODEX_ID_RE.fullmatch(session_id or ""):
        return 0
    if codex_writer_active(session_id):
        herdr("notification", "show", "Codex branch is active",
              "--body", f"{session_id} is active — open it and use /archive "
                         "in its TUI, or archive it in the external owner")
        return 1

    done = codex_run("archive", session_id, timeout=10)
    if done is None:
        why = "could not start the codex command"
    elif done.returncode != 0:
        why = flat(done.stderr) or f"archive exited with status {done.returncode}"
    else:
        return 0
    herdr("notification", "show", "Could not archive Codex branch",
          "--body", f"{session_id}: {why}")
    return 1


def dismiss(target: str) -> int:
    """Dismiss a folder or archive a saved Codex branch selected by fzf."""
    if target.startswith(HEADER_KEY):
        return hide_folder(target[len(HEADER_KEY):])
    if target.startswith(CODEX_KEY):
        session_id = target[len(CODEX_KEY):]
        if CODEX_ID_RE.fullmatch(session_id):
            return archive_codex_branch(session_id)
    return 0


def unhide_folder(folder: str | None) -> int:
    """Undo a dismissal (or all of them, with no folder given)."""
    state = load_state()
    before = hidden_folders(state)
    if folder:
        target = folder.rstrip("/")
        state["hidden"] = [f for f in state.get("hidden") or []
                           if str(f).rstrip("/") != target]
    else:
        state["hidden"] = []
    save_state(state)
    freed = len(before) - len(hidden_folders(state))
    print(f"herdr-agents: {freed} folder{'' if freed == 1 else 's'} unhidden")
    return 0


def recent_folders(limit: int = 40) -> list[str]:
    """Folders worth launching in, best first.

    Own launch history, then anywhere herdr already has a pane, then zoxide's
    frecency list — three sources because none alone covers a fresh machine,
    a folder you only ever open here, and a folder you only ever cd to.
    Anything dismissed with ctrl-x is filtered out of all three.
    """
    state = load_state()
    ordered = [f for f, _ in sorted(state.get("folders", {}).items(),
                                    key=lambda kv: -kv[1].get("last", 0))]
    ordered += [p.get("cwd") for p in herdr_json("pane", "list").get("panes") or []]
    if shutil.which("zoxide"):
        try:
            zoxide = subprocess.run(["zoxide", "query", "-l"], capture_output=True,
                                    text=True, timeout=3, check=False)
            ordered += zoxide.stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            pass
    out, seen = [], hidden_folders(state)
    for folder in ordered:
        folder = (folder or "").rstrip("/")
        if not folder or folder in seen or not os.path.isdir(folder):
            continue
        seen.add(folder)
        out.append(folder)
        if len(out) >= limit:
            break
    return out


def kinds_available() -> list[str]:
    """Installed agents, the last one launched first."""
    last = load_state().get("last_kind")
    found = [k for k in AGENT_KINDS if shutil.which(k)]
    if last in found:
        found.remove(last)
        found.insert(0, last)
    return found or list(AGENT_KINDS)


def default_kind(folder: str) -> str:
    state = load_state()
    per_folder = (state.get("folders", {}).get(folder) or {}).get("kind")
    return per_folder or (kinds_available() or ["claude"])[0]


def pick(lines: list[str], prompt: str, header: str,
         preview_cmd: str | None) -> tuple[str, str]:
    """Run fzf over plain lines, returning (key pressed, selected line)."""
    args = ["fzf", "--ansi", "--layout=reverse", "--info=inline", "--pointer=>",
            f"--prompt={prompt}", f"--header={header}"]
    if preview_cmd:
        args += ["--preview", preview_cmd, f"--preview-window={preview_window()}"]
    done = subprocess.run(args, input="\n".join(lines), capture_output=True,
                          text=True, check=False)
    if done.returncode != 0:
        return ("", "")
    out = done.stdout.splitlines()
    return ("", out[0] if out else "")


def agent_name_base(label: str, kind: str) -> str:
    """A herdr-legal agent name for `kind` running in `label`.

    Agent names are `[a-z][a-z0-9_-]{0,31}`, and a folder basename is not one:
    ~/notes/Inbox gives "Inbox-pi", which agent start rejects instantly
    with invalid_agent_name — the same answer on every retry, so the launch
    just spun and left the workspace at a shell. Capitalised, spaced, and
    dotted folder names all landed there.

    Truncated to 29 so unique_agent_name's "-<n>" suffix stays inside 32.
    """
    slug = re.sub(r"[^a-z0-9_-]+", "-", f"{label}-{kind}".lower()).strip("-_")
    if not slug[:1].isalpha():
        slug = f"a-{slug}".rstrip("-_")
    return slug[:29].rstrip("-_") or "agent"


def unique_agent_name(base: str) -> str:
    name, suffix = base, 1
    while herdr("agent", "get", name).strip():
        suffix += 1
        name = f"{base}-{suffix}"
    return name


# ------------------------------------------------------------------- splash
# The title cards that fill the wait live next door, in herdr_splash.py: five of
# them, several hundred lines of geometry, and none of it about picking an agent.
#
# It needs no symlink of its own. __file__ here is the link in ~/.local/bin, so
# resolving it lands on the real script in its checkout and the module is
# sitting beside it. If it is missing -- someone copied this file rather than
# linking it -- launching still works, it just prints a line like it used to.


def load_splash():
    """herdr_splash, or None. Imported by path, since this script is a symlink."""
    beside = os.path.join(os.path.dirname(os.path.realpath(__file__)), "herdr_splash.py")
    try:
        loader = importlib.machinery.SourceFileLoader("herdr_splash", beside)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module
    except Exception:  # noqa: BLE001 -- a broken optional card must not block launch
        return None


def next_card(splash, state: dict) -> str:
    """The card after the one the last launch used.

    Rotating beats choosing at random: four cards seen in order are four cards
    seen, where a coin would show the same one three times and hide another for
    a fortnight. The index is kept alongside the folder history, so it survives
    a restart and is one integer to reset.
    """
    index = int(state.get("splash", -1)) + 1
    state["splash"] = index
    return splash.CARD_NAMES[index % len(splash.CARD_NAMES)]


def start_agent(name: str, kind: str, pane_id: str,
                agent_args: tuple[str, ...] = ()) -> tuple[str, str]:
    """Start `kind` in `pane_id`. Returns (agent start's stdout, failure reason).

    A pane created a moment ago is still starting its shell, and agent start
    rejects it outright with agent_pane_busy rather than waiting — its own
    --timeout only covers agent readiness, not shell readiness. So retry, on a
    backoff that starts well inside a shell's startup rather than at a flat
    750ms: when the first attempt loses that race the second is worth making
    almost immediately, and the old constant spent most of its wait after the
    pane was already good.
    """
    why = "herdr agent start could not be run"
    for attempt in range(12):
        args = ("agent", "start", name, "--kind", kind, "--pane", pane_id,
                "--timeout", "60000")
        if agent_args:
            args += ("--",) + agent_args
        done = herdr_run(*args, timeout=90)
        if done is None:
            return "", why
        if done.returncode == 0 and done.stdout.strip():
            return done.stdout, ""
        why = error_code(done.stderr) or f"agent start exited {done.returncode}"
        # Only a pane still finishing its shell changes its mind on a retry.
        # A bad name, a missing pane or an unknown kind will not, and spending
        # nine seconds proving it just hides the reason.
        if why != "agent_pane_busy":
            break
        time.sleep(min(0.75, 0.1 * 2 ** attempt))
    return "", why


# ------------------------------------------------------------------ readiness
# `herdr agent start` does not return when the agent is ready. It returns on a
# fixed interactive-readiness wait: measured at 3.04s ± 0.01 across runs in
# herdr 0.8.0, unchanged when the agent is deliberately slowed by three seconds,
# so it is a constant and not a measurement of anything. pi is at its prompt in
# about 0.7s. Tying the card to that call therefore held it on a finished agent
# for the last ~2.3 seconds, which is the whole of the "why is it still up"
# complaint -- the wait it was covering had already ended.
#
# The agent's own lifecycle hook is the earlier and truthful signal. herdr's pi,
# claude and codex integrations call pane.report_agent_session as their TUI
# comes up, so `agent_session` appearing on the pane means the agent booted far
# enough to introduce itself by name. Watch for that and end the card there.
#
# It is only ever an *early* exit: an agent with no integration installed never
# reports one, `ready` never fires, and the card runs to `agent start` exactly
# as before. Abandoning the call is safe -- the server binds the name up front,
# and a `herdr agent start` killed mid-wait still leaves a named, running agent
# (verified with SIGHUP at 1.3s).

#: How often the pane is asked whether the agent has introduced itself.
READY_POLL_S = 0.15
#: Grace after an early exit for `agent start` to finish on its own, so the
#: common case still reaps its own thread rather than orphaning the CLI.
READY_JOIN_S = 0.3


def watch_ready(pane_id: str, ready: threading.Event, running) -> None:
    """Set `ready` once the pane's agent reports a session of its own."""
    while running() and not ready.is_set():
        pane = herdr_json("pane", "get", pane_id).get("pane") or {}
        if (pane.get("agent_session") or {}).get("agent"):
            ready.set()
            return
        time.sleep(READY_POLL_S)


def launch(folder: str, kind: str, agent_args: tuple[str, ...] = ()) -> int:
    label = os.path.basename(folder) or folder
    created = herdr_json("workspace", "create", "--cwd", folder,
                         "--label", label, "--focus")
    pane_id = (created.get("root_pane") or {}).get("pane_id")
    if not pane_id:
        herdr("notification", "show", "herdr-agents",
              "--body", f"could not create a workspace in {folder}")
        return 1
    name = unique_agent_name(agent_name_base(label, kind))
    outcome: dict = {}

    def work() -> None:
        outcome["started"], outcome["why"] = start_agent(
            name, kind, pane_id, agent_args=agent_args)

    # agent start goes on a thread and the animation is what this one does while
    # it waits, so the title card costs the launch nothing but its 220ms flash.
    worker = threading.Thread(target=work, daemon=True)
    worker.start()
    ready = threading.Event()
    threading.Thread(target=watch_ready, args=(pane_id, ready, worker.is_alive),
                     daemon=True).start()
    waiting = lambda: worker.is_alive() and not ready.is_set()
    state = load_state()
    splash = load_splash()
    if splash and splash.wanted():
        splash.play(kind, label, waiting, name=next_card(splash, state))
    else:
        print(f"{DIM}starting {kind} in {label}…{RESET}")
        while waiting():
            time.sleep(READY_POLL_S)
    # Only the card may end early; the popup must not linger past it, so once the
    # agent has said it is up the call gets a grace period and then the process
    # leaves. `ready` is proof of a successful start on its own.
    worker.join(READY_JOIN_S if ready.is_set() else None)
    started = outcome.get("started", "") or ("ready" if ready.is_set() else "")
    why = outcome.get("why") or "herdr agent start could not be run"
    folders = state.setdefault("folders", {})
    entry = folders.setdefault(folder, {"count": 0})
    entry.update(count=entry.get("count", 0) + 1, last=time.time(), kind=kind)
    # Deliberately starting an agent somewhere outranks an old dismissal.
    state["hidden"] = [f for f in state.get("hidden") or []
                       if str(f).rstrip("/") != folder.rstrip("/")]
    state["last_kind"] = kind
    save_state(state)
    if not started.strip():
        # The workspace is real and sitting at a shell either way, so leave it
        # rather than tearing down a pane the user can just type into.
        herdr("notification", "show", f"{kind} did not come up",
              "--body", f"{label}: {why} — shell is waiting in the new workspace")
        print(f"herdr-agents: agent start failed ({why})", file=sys.stderr)
        return 1
    return 0


def fork_notice(title: str, body: str) -> None:
    herdr("notification", "show", title, "--body", body)


def command_failure(done, fallback: str) -> str:
    if done is None:
        return fallback
    return (error_code(done.stderr) or flat(done.stderr)
            or f"command exited {done.returncode}")


def fork_pre_child_failure(child_pane_id: str, why: str) -> int:
    closed = close_created_empty_pane(child_pane_id)
    cleanup = ("the unused pane was closed" if closed else
               "the new pane could not be proven empty and was left visible")
    fork_notice("Could not fork Codex to the right", f"{why}; {cleanup}")
    print(f"herdr-agents: fork-right failed before child startup ({why})",
          file=sys.stderr)
    return 1


def fork_right_locked(pane_id: str) -> int:
    """Fork the invoking local Codex pane without ever replacing its writer."""
    parent, why = local_codex_pane(pane_id)
    if not parent:
        fork_notice("Could not fork Codex to the right", why)
        print(f"herdr-agents: fork-right preflight failed ({why})", file=sys.stderr)
        return 1

    done = herdr_run(
        "pane", "split", "--pane", pane_id, "--direction", "right",
        "--cwd", parent["cwd"], "--no-focus", timeout=10,
    )
    if done is None or done.returncode != 0:
        why = command_failure(done, "herdr pane split could not be run")
        fork_notice("Could not fork Codex to the right", why)
        print(f"herdr-agents: fork-right split failed ({why})", file=sys.stderr)
        return 1
    try:
        child_pane_id = (json.loads(done.stdout).get("result", {}).get("pane", {})
                         .get("pane_id", ""))
    except (AttributeError, ValueError):
        child_pane_id = ""
    if not child_pane_id or child_pane_id == pane_id:
        why = "Herdr did not identify the newly split pane"
        fork_notice("Could not fork Codex to the right", why)
        print(f"herdr-agents: fork-right split response was ambiguous ({why})",
              file=sys.stderr)
        return 1

    # The parent remains focused after the split, so it can still switch or
    # exit while this detached action runs. Recheck immediately before any
    # child process is started; this is the last point where cleanup is safe.
    current, why = local_codex_pane(pane_id)
    stable_fields = ("session_id", "pid", "cwd", "cwd_real")
    if (not current
            or any(current[field] != parent[field] for field in stable_fields)):
        why = why or "the parent Codex session changed after the pane split"
        return fork_pre_child_failure(child_pane_id, why)

    label = os.path.basename(parent["cwd"].rstrip(os.sep)) or "codex"
    name = unique_agent_name(agent_name_base(label, "codex"))
    started, why = start_agent(
        name, "codex", child_pane_id,
        agent_args=("fork", parent["session_id"]),
    )
    if not started.strip():
        return fork_pre_child_failure(child_pane_id, why)

    child_id, why = wait_for_fork_child(parent, child_pane_id)
    if not child_id:
        fork_notice(
            "Codex fork needs inspection",
            f"{why}; {child_pane_id} was left visible because child state is ambiguous",
        )
        print(f"herdr-agents: fork-right child verification failed ({why})",
              file=sys.stderr)
        return 1

    focused = herdr_run("agent", "focus", child_pane_id, timeout=10)
    if focused is None or focused.returncode != 0:
        why = command_failure(focused, "herdr agent focus could not be run")
        fork_notice(
            "Codex fork created",
            f"{child_id} is running in {child_pane_id}, but focus failed: {why}",
        )
        return 1
    return 0


def fork_right() -> int:
    """Serialize fork-right invocations originating from the same pane."""
    pane_id = os.environ.get("HERDR_PANE_ID") or ""
    if not pane_id:
        print("herdr-agents: HERDR_PANE_ID is not set", file=sys.stderr)
        return 1
    try:
        os.makedirs(FORK_LOCK_DIR, exist_ok=True)
        digest = hashlib.sha256(pane_id.encode()).hexdigest()
        lock_path = os.path.join(FORK_LOCK_DIR, f"{digest}.lock")
        # Open separately so creation errors can be reported before entering
        # the context that owns acquisition and release.
        lock_file = open(lock_path, "a+")  # noqa: SIM115
    except OSError as exc:
        why = f"could not create the per-pane fork lock: {flat(exc)}"
        fork_notice("Could not fork Codex to the right", why)
        return 1
    with lock_file:
        try:
            fcntl.lockf(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fork_notice("Codex fork already starting",
                        f"another fork-right action is active for {pane_id}")
            return 1
        except OSError as exc:
            why = f"could not acquire the per-pane fork lock: {flat(exc)}"
            fork_notice("Could not fork Codex to the right", why)
            return 1
        try:
            return fork_right_locked(pane_id)
        finally:
            fcntl.lockf(lock_file.fileno(), fcntl.LOCK_UN)


def choose_kind(folder: str) -> str:
    """The second step of ctrl-a: which agent to start here."""
    _, picked = pick(kinds_available(),
                     prompt=f"agent for {os.path.basename(folder)}> ",
                     header="enter start · esc cancel", preview_cmd=None)
    return picked.strip()


def picker_entries() -> tuple[list[dict], list[tuple[str, object]], dict[str, int]]:
    rows = collect()
    entries = group_by_folder(rows)
    counts = {folder: sum(1 for k, r in entries if k == "row" and r["cwd"] == folder)
              for k, folder in entries if k == "header"}
    return rows, entries, counts


def picker_lines(entries: list[tuple[str, object]], counts: dict[str, int]) -> list[str]:
    """fzf input: a hidden key field, then the rendered line.

    One list, two verbs. An agent row focuses that agent; a folder row starts a
    new agent there — which is why folders with nothing running are in the list
    at all. The HEADER_KEY sentinel is what tells the two apart.
    """
    return [f"{HEADER_KEY}{item}\t{render_header(item, counts[item])}"
            if kind == "header" else f"{item['key']}\t{render(item, folder=True)}"
            for kind, item in entries]


def main(argv: list[str]) -> int:
    # --splash and --list answer without touching herdr, so they work anywhere.
    if argv[:1] == ["--splash"]:
        splash = load_splash()
        if not splash:
            print("herdr-agents: herdr_splash.py is not beside this script", file=sys.stderr)
            return 1
        return splash.main(argv[1:])
    if argv[:1] == ["--unhide"]:
        return unhide_folder(argv[1] if len(argv) > 1 else None)
    if os.environ.get("HERDR_ENV") != "1" and "--list" not in argv:
        print("herdr-agents: not inside a herdr session", file=sys.stderr)
        return 1
    if argv[:1] == ["--fork-right"]:
        return fork_right()
    if len(argv) >= 2 and argv[0] == "--preview":
        return preview(argv[1])
    if len(argv) >= 2 and argv[0] == "--hide":
        # Only a folder entry can be forgotten; ctrl-x on an agent row hands us
        # its pane id, which is not a place and is left alone.
        target = argv[1]
        return hide_folder(target[len(HEADER_KEY):]
                           if target.startswith(HEADER_KEY) else "")
    if len(argv) >= 2 and argv[0] == "--dismiss":
        return dismiss(argv[1])

    rows, entries, counts = picker_entries()
    if "--list" in argv:
        color = sys.stdout.isatty()
        for kind, item in entries:
            print(render_header(item, counts[item], color) if kind == "header"
                  else render(item, color))
        return 0
    lines = picker_lines(entries, counts)
    if "--lines" in argv:  # what ctrl-x's reload re-reads
        print("\n".join(lines))
        return 0
    if not shutil.which("fzf"):
        print("herdr-agents: fzf is not installed", file=sys.stderr)
        return 1

    # fzf runs these through a shell, and as a plugin this path is herdr's
    # managed checkout rather than a path the user chose.
    me = shlex.quote(os.path.abspath(__file__))
    picked = subprocess.run(
        ["fzf", "--ansi", "--with-nth=2..", "--delimiter=\t",
         "--layout=reverse", "--info=inline", "--pointer=>",
         "--prompt=agent> ",
         ("--header=enter focus/start · ctrl-a kind · "
          "ctrl-x forget/archive saved branch · esc cancel"),
         "--expect=ctrl-a",
         # Land on an agent, so a reflex enter focuses rather than launching.
         # It has to be `load`, not `start`: start fires before the input is
         # read and the move is lost — measured, it silently does nothing.
         # Unbound straight after, or every ctrl-x reload would nudge the
         # cursor down again on top of the row the list just lost.
         "--bind=load:down+unbind(load)",
         # Dismiss a folder or saved Codex branch without leaving the picker:
         # the suggestion list is mostly zoxide's frecency, so it silts up with
         # /tmp and one-off checkouts, and a dismissal is only worth one key.
         f"--bind=ctrl-x:execute-silent({me} --dismiss {{1}})+reload({me} --lines)",
         "--preview", f"{me} --preview {{1}}",
         f"--preview-window={preview_window()}"],
        input="\n".join(lines), capture_output=True, text=True, check=False)
    if picked.returncode != 0:
        return 0
    out = picked.stdout.splitlines()
    key, choice = (out[0] if out else ""), (out[1] if len(out) > 1 else "")
    if not choice:
        return 0

    target = choice.split("\t", 1)[0].strip()
    folder = target[len(HEADER_KEY):] if target.startswith(HEADER_KEY) else ""
    row = next((r for r in rows if r["key"] == target), None)
    if key == "ctrl-a":
        # ctrl-a on an agent row means "another one alongside this", so it
        # launches in that agent's folder rather than focusing it.
        folder = folder or (row or {}).get("cwd", "")
        kind = choose_kind(folder) if folder else ""
        return launch(folder, kind) if kind else 0
    if folder:
        return launch(folder, default_kind(folder))
    return activate(row) if row else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
